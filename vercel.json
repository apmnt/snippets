{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/sketch-image.js": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "{dist/sketch-manifest.json,node_modules/@sparticuz/chromium/bin/**}"
    },
    "api/share.js": {
      "includeFiles": "dist/{index.html,sketch-manifest.json}"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/share"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/api/share"
    },
    {
      "handle": "filesystem"
    }
  ]
}
